<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36" version="24.7.12">
  <diagram name="Page-1" id="8pQHJrCK5WfG5-qsSCOW">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor TrafficSensor as TS\nparticipant \&quot;Central Control System\&quot; as CCS\nparticipant \&quot;TrafficLight\&quot; as TL\nparticipant \&quot;Additional TrafficSensor\&quot; as TS2\nparticipant \&quot;Additional TrafficLight\&quot; as TL2\n\n== Normal Operation ==\n\nTS -&gt; CCS: Collect traffic data\nCCS -&gt; TS: Acknowledgment\nTS -&gt; CCS: Send traffic data\nCCS -&gt; CCS: Process data (Decision Making)\nCCS -&gt; TL: Adjust traffic light\nTL -&gt; CCS: Acknowledge light adjustment\nCCS -&gt; TS: Request status (monitor sensor feedback)\nTS -&gt; CCS: Send status data\n\n== Concurrency and Synchronization ==\n\nTS2 -&gt; CCS: Collect traffic data (concurrent)\nCCS -&gt; TS2: Acknowledgment (concurrent)\nTS2 -&gt; CCS: Send traffic data\nCCS -&gt; CCS: Process data for second intersection\nCCS -&gt; TL2: Adjust traffic light for second intersection\nTL2 -&gt; CCS: Acknowledge light adjustment\nnote right of CCS: Ensure lights are synchronized at intersections\n\n== Error Handling ==\n\nTS -&gt; CCS: Fail to send data (Timeout)\nCCS -&gt; CCS: Detect sensor failure\nCCS -&gt; TL: Adjust traffic light based on fallback logic\nCCS -&gt; CCS: Log error and alert maintenance\nCCS -&gt; TS2: Adjust traffic light based on traffic from other sensors\n\n== Scalability ==\n\nloop For each new intersection\n  participant \&quot;Additional TrafficSensor[n]\&quot; as TSn\n  participant \&quot;Additional TrafficLight[n]\&quot; as TLn\n  TSn -&gt; CCS: Collect traffic data\n  CCS -&gt; TSn: Acknowledgment\n  TSn -&gt; CCS: Send traffic data\n  CCS -&gt; CCS: Process data for intersection[n]\n  CCS -&gt; TLn: Adjust traffic light at intersection[n]\n  TLn -&gt; CCS: Acknowledge light adjustment\n  note right: System manages concurrent data from multiple intersections\nend\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="iHvZNCiX-C1ZHgvuvOtH-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-241" y="-260" width="1862" height="1179" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
